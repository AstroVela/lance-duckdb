# name: test/sql/scan_rowid_native.test
# description: Point lookup and projection via DuckDB `rowid`
# group: [sql]

require lance

# Membership does not define output order.
query T
SELECT name FROM 'test/data/test_data.lance' WHERE rowid IN (2, 0, 4) ORDER BY name
----
Alice
Charlie
Eve

# Repeated SQL membership candidates do not duplicate input rows.
query T
SELECT name FROM 'test/data/test_data.lance' WHERE rowid IN (1, 1, NULL, 3) ORDER BY name
----
Bob
David

query I
SELECT count(*) FROM 'test/data/test_data.lance' WHERE rowid IN (1, 1, NULL)
----
1

query I
SELECT count(*) FROM 'test/data/test_data.lance' WHERE rowid IN (NULL)
----
0

# Project `rowid` (cast to BIGINT for stable test typing)
query TI
SELECT name, CAST(rowid AS BIGINT) FROM 'test/data/test_data.lance' WHERE rowid IN (2, 0, 4) ORDER BY 2
----
Alice	0
Charlie	2
Eve	4

# `rowid` matches `_rowid`
query I
SELECT COUNT(*) FROM (
  SELECT CAST(rowid AS BIGINT) AS r, _rowid AS u FROM 'test/data/test_data.lance'
) WHERE r != u
----
0
