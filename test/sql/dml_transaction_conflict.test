# name: test/sql/dml_transaction_conflict.test
# description: cache consistency after transaction commit conflicts
# group: [sql]

require lance

statement ok con1
ATTACH 'test/.tmp' AS conflict_ns (TYPE LANCE);

statement ok con1
CREATE OR REPLACE TABLE conflict_ns.main.transaction_conflict AS
SELECT 1::BIGINT AS id;

# Seed con2's connection-local dataset cache with the base snapshot.
query I con2
SELECT id FROM conflict_ns.main.transaction_conflict;
----
1

statement ok con2
BEGIN TRANSACTION;

statement ok con2
INSERT INTO conflict_ns.main.transaction_conflict VALUES (2);

# A different connection wins the optimistic commit race.
statement ok con1
INSERT INTO conflict_ns.main.transaction_conflict VALUES (3);

statement error con2
COMMIT;
----
TransactionContext Error:

# The failed connection must invalidate its base-version cache entry and open
# the winner's published snapshot. Its detached row remains invisible.
query I con2
SELECT id FROM conflict_ns.main.transaction_conflict ORDER BY id;
----
1
3

statement ok con1
DETACH conflict_ns;
