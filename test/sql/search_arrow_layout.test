# name: test/sql/search_arrow_layout.test
# description: Search reads nested Arrow layouts from the actual batch schema
# group: [sql]

require lance

# Generated by test/scripts/gen_search_arrow_layout_fixture.py. The fixture
# uses LargeList<BlobV2>, Blob structs with large string/binary siblings, and
# unmarked descriptor-shaped structs with the same physical layouts.
statement ok
ATTACH 'test/data' AS layout_ns (TYPE LANCE);

# Namespace binding loses Arrow offset widths through DuckDB logical types.
# Direct paths retain them; both routes must read identical values.
foreach source layout_ns.main.search_arrow_layout_fixture test/data/search_arrow_layout_fixture.lance

statement ok
CREATE OR REPLACE TEMP VIEW layout_fts AS
SELECT * FROM lance_fts('${source}', 'text', 'puppy', k = 4, prefilter = false);

statement ok
CREATE OR REPLACE TEMP VIEW layout_vector AS
SELECT * FROM lance_vector_search('${source}', 'vec', [0, 0]::FLOAT[2], k = 4, use_index = false, prefilter = false);

statement ok
CREATE OR REPLACE TEMP VIEW layout_hybrid AS
SELECT * FROM lance_hybrid_search('${source}', 'vec', [0, 0]::FLOAT[2], 'text', 'puppy', k = 4, use_index = false, prefilter = false);

foreach search layout_fts layout_vector layout_hybrid

# Even an unrelated scalar projection must accept the batch schema.
query I
SELECT id FROM ${search} ORDER BY id;
----
0
1
2
3

# Different list lengths, a null element, an empty list and a null list.
query IIII
SELECT id, len(clips), clips[1].size, clips[2].size FROM ${search} ORDER BY id;
----
0	2	3	5
1	1	NULL	NULL
2	0	NULL	NULL
3	NULL	NULL	NULL

# Validate both the descriptors and their 64-bit-offset siblings. Widening
# Float16 must happen before importing the actual batch schema.
query IITTR
SELECT id, info.video.size, '<' || info.label || '>', '<' || hex(info.payload) || '>', info.half
FROM ${search} ORDER BY id;
----
0	3	<alpha>	<00FF41>	1.5
1	5	<duck 中>	<42430044>	-2.25
2	NULL	<>	<>	NULL
3	NULL	NULL	NULL	NULL

# Unmarked lookalikes are ordinary structs, including their non-Blob kinds.
query IIIIT
SELECT id, lookalike[1].kind, lookalike[1].size, lookalike[2].size, lookalike[2].blob_uri
FROM ${search} ORDER BY id;
----
0	7	17	19	second
1	NULL	NULL	NULL	NULL
2	NULL	NULL	NULL	NULL
3	NULL	NULL	NULL	NULL

query IIITT
SELECT id, plain_info.descriptor.kind, plain_info.descriptor.size,
       '<' || plain_info.label || '>', '<' || hex(plain_info.payload) || '>'
FROM ${search} ORDER BY id;
----
0	7	17	<alpha>	<00FF41>
1	8	19	<duck 中>	<42430044>
2	NULL	NULL	<>	<>
3	NULL	NULL	NULL	NULL

# Keep the nested filter column readable when it is absent from the output.
query I
SELECT id FROM ${search} WHERE info.label = 'duck 中';
----
1

statement ok
PREPARE layout_lookup AS SELECT info.video.size, info.label FROM ${search} WHERE id = $1;

query IT
EXECUTE layout_lookup(0);
----
3	alpha

query IT
EXECUTE layout_lookup(1);
----
5	duck 中

statement ok
DEALLOCATE layout_lookup;

statement ok
DROP VIEW ${search};

endloop

endloop

statement ok
DETACH layout_ns;
