# name: test/sql/scan_rowid_in.test
# description: Point lookup via `WHERE _rowid IN (...)` rewrite
# group: [sql]

require lance

# Membership does not define output order.
query T
SELECT name FROM 'test/data/test_data.lance' WHERE _rowid IN (2, 0, 4) ORDER BY name
----
Alice
Charlie
Eve

# Repeated SQL membership candidates do not duplicate input rows.
query T
SELECT name FROM 'test/data/test_data.lance' WHERE _rowid IN (1, 1, NULL, 3) ORDER BY name
----
Bob
David

query I
SELECT count(*) FROM 'test/data/test_data.lance' WHERE _rowid IN (1, 1, NULL)
----
1

query I
SELECT count(*) FROM 'test/data/test_data.lance' WHERE _rowid IN (NULL)
----
0

# Plain DuckDB is the membership-semantics oracle.
query I
SELECT count(*) FROM (VALUES (1), (2)) AS ordinary(r) WHERE r IN (1, 1, NULL)
----
1

# Non-existent row ids: missing ids are ignored
query T
SELECT name FROM 'test/data/test_data.lance' WHERE _rowid IN (0, 999, 4) ORDER BY name
----
Alice
Eve
