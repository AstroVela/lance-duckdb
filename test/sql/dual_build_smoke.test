# name: test/sql/dual_build_smoke.test
# description: Stable smoke test shared by official DuckDB and Vane builds
# group: [sql]

require lance

# The same extension source must register and execute in both DuckDB ABIs.
query I
SELECT count(*) FROM 'test/data/test_data.lance';
----
5

query I
SELECT count(*) FROM 'test/data/test_data.lance' WHERE age > 30;
----
3

# Common Blob descriptor support must be available in both builds.
query II
SELECT video.kind, video.size
FROM 'test/data/blob_v2_fixture.lance' WHERE id = 3;
----
3	19

# Common Blob URI and filesystem registration must also work in both builds.
statement ok
SET VARIABLE smoke_blob_uri = (SELECT lance_blob_uri('test/data/blob_v2_fixture.lance', 'video', _rowid) FROM 'test/data/blob_v2_fixture.lance' WHERE id = 0);

query IT
SELECT size, content::VARCHAR FROM read_blob(getvariable('smoke_blob_uri'));
----
3	abc
